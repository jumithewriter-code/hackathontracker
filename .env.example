# ─── Neon Postgres ───────────────────────────────────────────────────────────
# Neon dashboard → your project → "Connect". Copy BOTH strings.
#
# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same, but WITHOUT "-pooler"). Used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── App passcode ────────────────────────────────────────────────────────────
# Anyone who opens the site must enter this once. Pick something long.
APP_PASSCODE="change-me-to-something-long"

# ─── Tests (optional) ────────────────────────────────────────────────────────
# A SEPARATE Neon branch for integration tests. Tests delete data, so never
# point this at your real database. If unset, integration tests are skipped.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-test-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
